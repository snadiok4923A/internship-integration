PORT=3000
NODE_ENV=development
# Comma-separated exact origins. Use the deployed frontend origin(s) in production.
FRONTEND_URL=http://127.0.0.1:5500,http://localhost:5500,http://127.0.0.1:8000,http://localhost:8000
# Optional absolute or backend-working-directory-relative path for a persistent SQLite volume.
DATABASE_PATH=./database/internships.db
# Set DATABASE_URL for PostgreSQL/Neon production. When set, PostgreSQL is selected instead of SQLite.
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
